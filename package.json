{
  "name": "@fatduckai/ai",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "scope": "@fatduckai"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fatduckai/ai.git"
  },
  "scripts": {
    "build": "bun run build:clean && bun run build:js && bun run build:types",
    "build:clean": "rm -rf dist",
    "build:js": "bun build ./index.ts --outdir ./dist --target node --sourcemap=external",
    "build:types": "tsc --declaration --emitDeclarationOnly --outDir dist",
    "watch": "bun build ./index.ts --outdir ./dist --target node --watch",
    "dev": "bun --watch index.ts",
    "telegram:dev": "tsx telegram-bot.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepack": "bun run build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "publish-packages": "bun run build && changeset publish",
    "release": "changeset publish",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:drop": "drizzle-kit drop"
  },
  "version": "1.0.0",
  "type": "module",
  "tsx": {
    "nodeModules": [
      "crypto",
      "path",
      "fs",
      "os",
      "util",
      "events",
      "stream",
      "buffer",
      "querystring",
      "url",
      "http",
      "https",
      "net",
      "tls",
      "zlib"
    ]
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "keywords": [
    "prompt-engineering",
    "llm",
    "ai",
    "template"
  ],
  "author": "Fat Duck AI",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.3",
    "node-cron": "^3.0.3",
    "postgres": "^3.4.5",
    "zod": "^3.23.8",
    "grammy": "^1.21.1"
  },
  "devDependencies": {
    "@biomejs/biome": "1.5.3",
    "@changesets/cli": "^2.27.9",
    "@types/bun": "^1.1.13",
    "@types/node-cron": "^3.0.11",
    "bun-types": "latest",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.3.3"
  }
}
